#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/samples/contests/robocup/protos/RobocupSoccerField.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/K1.proto"
WorldInfo {
  basicTimeStep 2
}
Viewpoint {
  orientation -0.2 0.2 0.96 1.6
  position 0 -2.5 1.2
  follow "K1"
}
DEF SKY TexturedBackground {}
DEF LIGHT TexturedBackgroundLight {}
RectangleArena {
  floorSize 30 30
}
DEF FLOOR_PATCH Solid {
  translation 0 0 -5
  children [
    Shape {
      appearance DEF FLOOR_PATCH_APPEARANCE PBRAppearance {
        baseColor 0.2 0.5 0.2
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 30 30
      }
    }
  ]
  name "floor patch"
}
DEF DISTRACTOR_0 Solid {
  translation 2 1 0.4
  children [ Shape { appearance PBRAppearance { baseColor 1 1 1 roughness 0.5 metalness 0 } geometry Cylinder { height 0.8 radius 0.05 } } ]
  name "post"
}
DEF DISTRACTOR_1 Solid {
  translation 2 -1 0.15
  children [ Shape { appearance PBRAppearance { baseColor 0.9 0.2 0.1 roughness 0.5 metalness 0 } geometry Box { size 0.3 0.3 0.3 } } ]
  name "box"
}
DEF DISTRACTOR_2 Solid {
  translation 3 0 0.1
  children [ Shape { appearance PBRAppearance { baseColor 0.1 0.2 0.9 roughness 0.5 metalness 0 } geometry Cylinder { height 0.2 radius 0.12 } } ]
  name "can"
}
K1 {
  translation 0 0 0.56
  controller "collect"
  controllerArgs [ "val" "300" "21" "field" ]
  supervisor TRUE
}
DEF BALL Solid {
  translation 2 0 0.11
  children [ DEF BALL_SHAPE Shape { appearance PBRAppearance { roughness 0.4 metalness 0 baseColorMap ImageTexture { url [ "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/balls/protos/textures/football_base_color.jpg" ] } } geometry Sphere { radius 0.11 subdivision 3 } } ]
  name "ball" boundingObject USE BALL_SHAPE physics Physics { density -1 mass 0.45 damping Damping { linear 0.3 angular 0.3 } }
}
RobocupSoccerField {
  translation 0 0 0.002
  size "kid"
  turfPhysics FALSE
}
